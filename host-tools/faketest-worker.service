[Unit]
Description=Faketest mail worker
After=network-online.target docker.service

[Service]
Type=oneshot
User=chris
Group=chris
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/tailshare/Faketest-Mails /home/chris/web/staging.afd-im-netz.de /home/chris/.ssh -/home/chris/.cache/huggingface -/home/chris/.cache/ctranslate2
ReadOnlyPaths=/etc/faketest /home/chris/.config/opencode /opt/faketest-transcribe
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
CapabilityBoundingSet=
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# faster-whisper/ctranslate2 uses native CPU acceleration and runtime libraries
# that may require syscalls outside systemd's conservative @system-service set.
# Keep the other filesystem/user/device protections, but do not apply a seccomp
# SystemCallFilter here; otherwise the transcription subprocess can die with
# SIGSYS (return code -31) while processing videos.
UMask=0077
ExecStart=/usr/local/sbin/faketest-worker.py
